# ColdReach Lead Intelligence Engine Configuration
# ===================================================

# LinkedIn Voyager API Session (Copy li_at cookie from Chrome DevTools)
# LINKEDIN_COOKIE=your_li_at_cookie_value

# Optional Hunter.io API key (free tier = 25 lookups/month)
# HUNTER_API_KEY=your_hunter_api_key

# Optional Proxy Configuration
# CR_PROXY=http://user:pass@host:port
# CR_PROXY_FILE=proxies.txt
# CR_FREE_PROXY=true

# Optional Request Delay Jitter (seconds)
# CR_DELAY_MIN=1.0
# CR_DELAY_MAX=2.5
